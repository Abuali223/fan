# Bilimdon — muhit sozlamalari.
# Nusxa oling:  cp .env.example .env

# Server porti va manzili
PORT=3000
HOST=0.0.0.0

# JWT maxfiy kaliti — ISHLAB CHIQARISHDA ALBATTA O'ZGARTIRING!
# Uzun, tasodifiy satr kiriting (masalan: openssl rand -hex 32)
JWT_SECRET=please-change-this-to-a-long-random-secret

# Token amal qilish muddati (soniyalarda). Default: 7 kun
JWT_EXPIRES_IN=604800

# SQLite ma'lumotlar bazasi fayli (ixtiyoriy)
# DB_PATH=./server/data/bilimdon.db

# Muhit turi
NODE_ENV=development
